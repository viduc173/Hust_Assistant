# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Model dung de sinh cau tra loi. Mac dinh dung claude-opus-5 (chat luong cao nhat).
# Co the doi sang claude-sonnet-5 (re hon, du dung cho FAQ) hoac claude-haiku-4-5 (re nhat, nhanh nhat).
CLAUDE_MODEL=claude-opus-5

# --- OpenAI (embeddings) ---
# Anthropic khong co embedding model rieng, dung OpenAI text-embedding-3-small.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Vector DB (Chroma, local) ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=hust_noiquy

# --- App ---
BACKEND_PORT=8000
# So chunk lay ra lam ngu canh cho moi cau hoi
RAG_TOP_K=5

# --- Bao mat khi deploy public ---
# Domain duoc phep goi API, phan cach boi dau phay. "*" = cho phep tat ca (chi
# nen dung khi test local). Khi da co domain that, doi thanh vd:
# ALLOWED_ORIGINS=https://ten-app.onrender.com
ALLOWED_ORIGINS=*
# So request toi da / 1 IP / phut cho /api/chat, chong lam dung ton phi API.
RATE_LIMIT_PER_MINUTE=8
